PORT=3001
GITHUB_TOKEN=your_github_personal_access_token_here
CORS_ORIGIN=http://localhost:5173

# --- AI: Gemma 4 (the only AI model RepoPilot uses) ---
# Set ONE of these. Gemma 4 is reached through the first one configured:
#   1. Google AI Studio / Gemini API key  -> runs gemma-4-31b-it
#   2. OpenRouter key                     -> runs google/gemma-4-31b-it
#   3. Local Ollama server                -> runs gemma4:e4b (private, offline)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OLLAMA_URL=http://localhost:11434

# Optional tuning
# GEMMA_BACKEND=auto                     # auto | gemini | openrouter | ollama
# GEMMA_MODEL=gemma-4-31b-it             # main model (long answers, analysis, README, Time Machine)
# GEMMA_FAST_MODEL=gemma-4-26b-a4b-it    # short tasks (file descriptions, summaries, explanations)
# GEMMA_OLLAMA_MODEL=gemma4:e4b
# GEMMA_TIMEOUT_MS=90000
# GEMMA_FILE_DESCRIPTIONS=5              # files described by Gemma during analysis (0 = off)
# GEMMA_STRICT=false                     # true = no rule-based fallback when Gemma fails
