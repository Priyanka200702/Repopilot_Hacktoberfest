+    let count = 0;
+    for (const s of splitSentences(out)) {
+      const n = s.trim().split(/\s+/).length;
+      if (count + n > maxWords) break;
+      kept.push(s.trim());
+      count += n;
+    }
+    out = kept.length ? kept.join(' ') : `${words.slice(0, maxWords).join(' ').replace(/[,;:]$/, '')}…`;
+  }
